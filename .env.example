# Never commit an actual token. Copy this file to .env locally or set variables in your shell.
MODELSCOPE_API_KEY=
ONEBOOKWIKI_EMBEDDING_BASE_URL=https://api-inference.modelscope.cn/v1
ONEBOOKWIKI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
ONEBOOKWIKI_EMBEDDING_BATCH_SIZE=16

# Local BAAI/bge-m3 SentenceTransformers model. Use a local directory for offline use.
ONEBOOKWIKI_BGE_M3_MODEL=BAAI/bge-m3
# Leave unset for automatic device selection; set cpu, cuda, or cuda:0 to override.
ONEBOOKWIKI_BGE_M3_DEVICE=
ONEBOOKWIKI_BGE_M3_BATCH_SIZE=8

# Local PP-OCRv5 mobile models. Use local directories for offline PDF structure assistance.
ONEBOOKWIKI_PDF_OCR_DET_MODEL=D:/models/PaddleOCR/PP-OCRv5_mobile_det_infer
ONEBOOKWIKI_PDF_OCR_REC_MODEL=D:/models/PaddleOCR/PP-OCRv5_mobile_rec_infer
# Leave unset for automatic device selection; set cpu, gpu, or gpu:0 to override.
ONEBOOKWIKI_PDF_OCR_DEVICE=cpu
ONEBOOKWIKI_PDF_OCR_BATCH_SIZE=1
ONEBOOKWIKI_PDF_OCR_DPI=180
ONEBOOKWIKI_PDF_OCR_CONFIDENCE=0.75
ONEBOOKWIKI_PDF_OCR_MAX_PAGES=12

# Optional OpenAI-compatible generation endpoint.
ONEBOOKWIKI_LLM_API_KEY=
OPENAI_API_KEY=
ONEBOOKWIKI_LLM_PROVIDER=openai-compatible
ONEBOOKWIKI_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
ONEBOOKWIKI_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
ONEBOOKWIKI_LLM_TIMEOUT=60
# Set this when the endpoint has a known context window, for example 32000.
ONEBOOKWIKI_LLM_CONTEXT_WINDOW=
# Chat sessions are public only when the URL is known; protect admin audit endpoints.
ONEBOOKWIKI_ADMIN_TOKEN=
ONEBOOKWIKI_CHAT_MAX_QUESTION_CHARS=4000
ONEBOOKWIKI_CHAT_MAX_TURNS=100
ONEBOOKWIKI_CHAT_LEASE_SECONDS=300
ONEBOOKWIKI_CHAT_WORKER_IDLE=1
